/target
.idea/
# Claude Code's own per-project state is local.
.claude/
# Compiled golden-vector generator (tools/blip-golden/build.sh builds into target/)
/tools/blip-golden/gen_golden

# The SPA: `pnpm run build` in `web/` produces `web/dist`. The directory must exist for the crate to
# compile, which is what the committed `web/dist/.gitkeep` is for.
/web/node_modules/
/web/dist/*
!/web/dist/.gitkeep

# Run directories, `$GB_RUN_DIR` (default `./runs`).
/runs
