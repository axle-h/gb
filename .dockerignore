# The context is the crates' source, the pokered submodule's source and the `web/` project.

target/
**/node_modules/
**/.git
.git/
.gitignore
.gitmodules
runs/
docs/
vendor/Blip_Buffer/
.github/
*.md
Dockerfile
.dockerignore
docker-compose.yml

# Runtime files of a desktop run; the container never loads either.
poke-agent-sdl/pokemon-red.sav
poke-agent-sdl/pokemon-red.bin

# Built by stage 2, never taken from the host, where it could be from a different checkout.
poke-agent-web/web/dist/

# Host build outputs, all generated by stage 1. Recursive globs, since `*.o` alone leaves
# `pokered/gfx/pics_red.o`, and an object from a newer rgbds stops the build.
vendor/pokered/**/*.o
vendor/pokered/**/*.gbc
vendor/pokered/**/*.sym
vendor/pokered/**/*.map
vendor/pokered/**/*.patch
vendor/pokered/**/*.1bpp
vendor/pokered/**/*.2bpp
vendor/pokered/**/*.pic
vendor/pokered/tools/gfx
vendor/pokered/tools/make_patch
vendor/pokered/tools/pkmncompress
vendor/pokered/tools/scan_includes
